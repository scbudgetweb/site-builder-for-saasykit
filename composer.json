{
    "name": "scbudgetweb/site-builder-for-saasykit",
    "description": "Branding, a plain base theme, block-built pages, a block library, navigation menus and legal pages for SaaSykit, managed in Filament.",
    "keywords": ["laravel", "filament", "saasykit", "page builder", "cms", "branding"],
    "homepage": "https://github.com/scbudgetweb/site-builder-for-saasykit",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "intervention/image": "^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "intervention/image": "^4.0 (with Laravel 13): lets Website › Media settings shrink large photos and remove their location data on upload"
    },
    "autoload": {
        "psr-4": {
            "ScBudgetWeb\\SiteBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScBudgetWeb\\SiteBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ScBudgetWeb\\SiteBuilder\\SiteBuilderServiceProvider"
            ],
            "aliases": {
                "SiteBuilder": "ScBudgetWeb\\SiteBuilder\\Facades\\SiteBuilder"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
